index="aws-cloudtrail-fdns" sourcetype="aws:s3:cloudwatchlogs"
earliest=-24h latest=now
| spath
| search accountId IN ("772618793657","776171595951")
| eval environment=case(
    accountId="772618793657","R2D2 Production",
    accountId="776171595951","R2D2 Non-production"
  )
| stats count AS events
        dc(logStream) AS log_streams
        latest(_time) AS latest_event
  BY environment accountId logGroup
| convert ctime(latest_event)
| sort environment logGroup



| tstats count AS events max(_time) AS latest_event
  WHERE index="aws-cloudtrail-fdns"
    earliest=-7d latest=now
  BY sourcetype source
| rex field=source "(?<account_id>772618793657|776171595951)"
| where isnotnull(account_id)
| eval environment=case(
    account_id="772618793657","R2D2 Production",
    account_id="776171595951","R2D2 Non-production"
  )
| stats sum(events) AS events
        max(latest_event) AS latest_event
        first(source) AS example_source
  BY environment account_id sourcetype
| convert ctime(latest_event)
| sort environment sourcetype

